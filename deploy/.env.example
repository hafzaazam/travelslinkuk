# =============================================================================
# Travel Links Solution — Production environment
# Copy to /var/www/travelslink/.env on the server and fill in real values.
# Never commit the real .env to git.
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# --- Lovable Cloud / Supabase (REQUIRED) ---
# Get these from Lovable: Project → Cloud → Settings → API.
# The same project that the live Lovable site uses.

# Server-side (used by createServerFn handlers)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # ONLY if you actually use admin server functions
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Client-side (baked into the JS bundle at build time — must be set BEFORE `bun run build`)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Optional ---
# Only set if you use the Lovable AI Gateway from server functions.
# LOVABLE_API_KEY=
